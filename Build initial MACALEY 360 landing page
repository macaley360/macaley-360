/* =========================================================
   MACALEY 360
   Hoja de estilos principal
   ========================================================= */

:root {
    --background: #f5f5f2;
    --surface: #ffffff;
    --dark: #111111;
    --dark-soft: #1c1c1c;
    --text: #202020;
    --muted: #6d6d6d;
    --line: #deded8;
    --accent: #a8d86e;
    --accent-dark: #6f9f35;

    --max-width: 1180px;
    --radius: 18px;
}


/* ---------- BASE ---------- */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    background: var(--background);
    color: var(--text);

    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

.container {
    width: min(
        calc(100% - 48px),
        var(--max-width)
    );

    margin: 0 auto;
}

.narrow {
    max-width: 850px;
}


/* ---------- HEADER ---------- */

.site-header {
    position: sticky;
    top: 0;
    z-index: 100;

    background: rgba(245, 245, 242, 0.94);

    border-bottom: 1px solid var(--line);

    backdrop-filter: blur(12px);
}

.header-inner {
    min-height: 76px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;
}

.brand {
    display: flex;
    align-items: center;

    gap: 12px;

    font-weight: 700;
    letter-spacing: 0.03em;
}

.brand-mark {
    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    border-radius: 9px;

    background: var(--dark);
    color: var(--accent);

    font-size: 15px;
}

.brand-name {
    font-size: 15px;
}

.main-nav {
    display: flex;
    align-items: center;
    gap: 28px;

    font-size: 14px;
}

.main-nav a {
    color: var(--muted);

    transition:
        color 0.2s ease;
}

.main-nav a:hover {
    color: var(--dark);
}


/* ---------- HERO ---------- */

.hero {
    min-height: 680px;

    display: flex;
    align-items: center;

    background:
        radial-gradient(
            circle at 80% 20%,
            rgba(168, 216, 110, 0.22),
            transparent 28%
        ),
        var(--background);
}

.hero-content {
    padding: 100px 0;
}

.eyebrow,
.section-label {
    display: inline-block;

    margin-bottom: 20px;

    font-size: 12px;
    font-weight: 700;

    letter-spacing: 0.16em;

    color: var(--accent-dark);
}

.hero h1 {
    max-width: 900px;

    margin: 0 0 28px;

    font-size:
        clamp(60px, 11vw, 150px);

    line-height: 0.9;

    letter-spacing: -0.07em;

    color: var(--dark);
}

.hero-lead {
    max-width: 720px;

    margin: 0;

    font-size:
        clamp(20px, 3vw, 30px);

    line-height: 1.35;

    color: #444;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;

    gap: 12px;

    margin-top: 42px;
}


/* ---------- BUTTONS ---------- */

.button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 48px;

    padding: 0 22px;

    border-radius: 999px;

    font-size: 14px;
    font-weight: 700;

    transition:
        transform 0.2s ease,
        background 0.2s ease;
}

.button:hover {
    transform: translateY(-2px);
}

.button-primary {
    background: var(--dark);
    color: white;
}

.button-secondary {
    border: 1px solid var(--line);
    background: white;
}


/* ---------- GENERAL SECTIONS ---------- */

.section,
.intro {
    padding: 120px 0;
}

.intro {
    background: var(--surface);
}

.section-heading {
    max-width: 800px;

    margin-bottom: 60px;
}

.section-heading h2,
.intro h2 {
    margin: 0 0 22px;

    font-size:
        clamp(38px, 6vw, 72px);

    line-height: 1;

    letter-spacing: -0.05em;

    color: var(--dark);
}

.section-heading p,
.intro p {
    margin: 0;

    max-width: 720px;

    font-size: 18px;

    color: var(--muted);
}


/* ---------- DARK SECTION ---------- */

.section-dark {
    background: var(--dark);
    color: white;
}

.section-dark .section-heading h2 {
    color: white;
}

.section-dark .section-heading p {
    color: #bcbcbc;
}

.section-dark .section-label {
    color: var(--accent);
}


/* ---------- CARDS ---------- */

.cards {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 1px;

    background: #3a3a3a;

    border: 1px solid #3a3a3a;
}

.card {
    min-height: 300px;

    padding: 32px;

    background: var(--dark-soft);
}

.card-number {
    display: block;

    margin-bottom: 70px;

    color: var(--accent);

    font-size: 13px;
    font-weight: 700;
}

.card h3 {
    margin: 0 0 14px;

    font-size: 24px;
}

.card p {
    margin: 0;

    color: #aaa;

    font-size: 15px;
}


/* ---------- PRINCIPLES ---------- */

.principles {
    border-top: 1px solid var(--line);
}

.principle {
    display: grid;

    grid-template-columns: 100px 1fr;

    gap: 30px;

    padding: 34px 0;

    border-bottom: 1px solid var(--line);
}

.principle > strong {
    color: var(--accent-dark);

    font-size: 14px;
}

.principle h3 {
    margin: 0 0 8px;

    font-size: 24px;
}

.principle p {
    max-width: 650px;

    margin: 0;

    color: var(--muted);
}


/* ---------- HORIZON ---------- */

.horizon {
    background: #ecece7;
}

.roadmap {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 1px;

    background: var(--line);

    border: 1px solid var(--line);
}

.roadmap-item {
    min-height: 270px;

    padding: 30px;

    background: var(--surface);
}

.roadmap-item > span {
    display: block;

    margin-bottom: 70px;

    font-size: 13px;
    font-weight: 700;

    color: var(--muted);
}

.roadmap-item.active {
    background: var(--dark);
    color: white;
}

.roadmap-item.active > span {
    color: var(--accent);
}

.roadmap-item h3 {
    margin: 0 0 12px;

    font-size: 22px;
}

.roadmap-item p {
    margin: 0;

    color: var(--muted);

    font-size: 14px;
}

.roadmap-item.active p {
    color: #aaa;
}


/* ---------- STATUS ---------- */

.status {
    padding: 80px 0;

    background: var(--accent);
}

.status-inner {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 40px;
}

.status h2 {
    margin: 0 0 12px;

    font-size: 40px;

    letter-spacing: -0.04em;
}

.status p {
    max-width: 650px;

    margin: 0;

    color: #3d4b2d;
}

.status-badge {
    display: inline-flex;

    align-items: center;

    gap: 10px;

    padding: 12px 18px;

    border-radius: 999px;

    background: rgba(255, 255, 255, 0.6);

    font-size: 13px;
    font-weight: 700;

    white-space: nowrap;
}

.status-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: var(--accent-dark);
}


/* ---------- FOOTER ---------- */

.site-footer {
    padding: 60px 0;

    background: var(--dark);

    color: white;
}

.footer-inner {
    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    gap: 40px;
}

.footer-inner strong {
    font-size: 18px;
}

.footer-inner p {
    margin: 8px 0 0;

    color: #888;

    font-size: 13px;
}

.footer-inner > span {
    color: #777;

    font-size: 12px;
}


/* ---------- RESPONSIVE ---------- */

@media (max-width: 900px) {

    .main-nav {
        display: none;
    }

    .hero {
        min-height: 580px;
    }

    .cards,
    .roadmap {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .status-inner,
    .footer-inner {
        align-items: flex-start;

        flex-direction: column;
    }
}


@media (max-width: 600px) {

    .container {
        width: min(
            calc(100% - 32px),
            var(--max-width)
        );
    }

    .section,
    .intro {
        padding: 80px 0;
    }

    .hero-content {
        padding: 80px 0;
    }

    .hero h1 {
        font-size: 62px;
    }

    .cards,
    .roadmap {
        grid-template-columns: 1fr;
    }

    .principle {
        grid-template-columns: 1fr;

        gap: 8px;
    }

    .card,
    .roadmap-item {
        min-height: auto;
    }

    .card-number,
    .roadmap-item > span {
        margin-bottom: 40px;
    }
}
