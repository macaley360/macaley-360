/* =========================================
   MACALEY 360
   Base visual
   ========================================= */

:root {
    --background: #f5f5f3;
    --surface: #ffffff;
    --text: #151515;
    --muted: #686868;
    --border: #ddddda;
    --dark: #111111;
    --dark-muted: #bdbdb8;

    --max-width: 1180px;
}


/* =========================================
   RESET
   ========================================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family:
        Arial,
        Helvetica,
        sans-serif;

    background: var(--background);
    color: var(--text);
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}


/* =========================================
   LAYOUT
   ========================================= */

.container {
    width: min(
        calc(100% - 48px),
        var(--max-width)
    );

    margin: 0 auto;
}


/* =========================================
   HEADER
   ========================================= */

.site-header {
    position: sticky;
    top: 0;
    z-index: 100;

    background: rgba(245, 245, 243, 0.94);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
}

.header-content {
    min-height: 76px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
}

.brand {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.04em;
}

.brand span {
    font-weight: 400;
}

.navigation {
    display: flex;
    gap: 28px;

    font-size: 14px;
}

.navigation a {
    color: var(--muted);
    transition: color 0.2s ease;
}

.navigation a:hover {
    color: var(--text);
}


/* =========================================
   HERO
   ========================================= */

.hero {
    min-height: 78vh;

    display: flex;
    align-items: center;

    border-bottom: 1px solid var(--border);
}

.hero-content {
    padding: 110px 0;
}

.eyebrow {
    margin: 0 0 18px;

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;

    color: var(--muted);
}

.hero h1 {
    max-width: 850px;

    margin: 0;

    font-size: clamp(
        48px,
        8vw,
        104px
    );

    line-height: 0.98;
    letter-spacing: -0.065em;
}

.hero-description {
    max-width: 650px;

    margin: 36px 0 0;

    font-size: 20px;
    color: var(--muted);
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;

    margin-top: 40px;
}


/* =========================================
   BUTTONS
   ========================================= */

.button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 48px;

    padding: 0 22px;

    border: 1px solid var(--text);

    font-size: 14px;
    font-weight: 600;

    transition:
        background 0.2s ease,
        color 0.2s ease;
}

.button.primary {
    background: var(--text);
    color: white;
}

.button.primary:hover {
    background: #333;
}

.button.secondary {
    background: transparent;
}

.button.secondary:hover {
    background: var(--text);
    color: white;
}


/* =========================================
   SECTIONS
   ========================================= */

.section {
    padding: 120px 0;

    border-bottom: 1px solid var(--border);
}

.section-heading {
    max-width: 760px;
}

.section h2 {
    margin: 0;

    font-size: clamp(
        36px,
        5vw,
        64px
    );

    line-height: 1.05;
    letter-spacing: -0.05em;
}

.section-heading > p:last-child {
    margin-top: 28px;

    color: var(--muted);
    font-size: 18px;
}


/* =========================================
   CARDS
   ========================================= */

.cards {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 1px;

    margin-top: 70px;

    background: var(--border);

    border: 1px solid var(--border);
}

.card {
    min-height: 310px;

    padding: 36px;

    background: var(--surface);
}

.card-number {
    display: block;

    margin-bottom: 80px;

    font-size: 12px;
    color: var(--muted);
}

.card h3 {
    margin: 0 0 14px;

    font-size: 24px;
}

.card p {
    margin: 0;

    color: var(--muted);
}


/* =========================================
   DARK SECTION
   ========================================= */

.section-dark {
    background: var(--dark);
    color: white;

    border-bottom-color: var(--dark);
}

.section-dark .eyebrow {
    color: var(--dark-muted);
}

.split {
    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 100px;
}

.split h2 {
    max-width: 550px;
}

.split p {
    max-width: 580px;

    margin-top: 0;
    margin-bottom: 24px;

    color: var(--dark-muted);
    font-size: 18px;
}


/* =========================================
   HORIZON
   ========================================= */

.horizon {
    max-width: 850px;
}

.horizon > p:not(.eyebrow) {
    max-width: 720px;

    margin-top: 28px;

    color: var(--muted);
    font-size: 18px;
}


/* =========================================
   FOOTER
   ========================================= */

.site-footer {
    padding: 50px 0;

    background: var(--dark);
    color: white;
}

.footer-content {
    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    gap: 30px;
}

.footer-content strong {
    font-size: 18px;
}

.footer-content p {
    margin: 6px 0 0;

    color: var(--dark-muted);
    font-size: 14px;
}


/* =========================================
   RESPONSIVE
   ========================================= */

@media (max-width: 800px) {

    .navigation {
        display: none;
    }

    .hero {
        min-height: auto;
    }

    .hero-content {
        padding: 90px 0;
    }

    .hero h1 {
        font-size: clamp(
            46px,
            14vw,
            76px
        );
    }

    .hero-description {
        font-size: 18px;
    }

    .section {
        padding: 85px 0;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .card {
        min-height: auto;
    }

    .card-number {
        margin-bottom: 50px;
    }

    .split {
        grid-template-columns: 1fr;

        gap: 45px;
    }

    .footer-content {
        align-items: flex-start;

        flex-direction: column;
    }
}
